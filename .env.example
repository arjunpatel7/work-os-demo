# Copy to .env and fill in. Modal reads .env when you deploy.

# Secret: your TypeSafe API key.
TYPESAFE_API_KEY=

# Public values, from the WorkOS dashboard (Agents → Configuration).
AUTHKIT_DOMAIN=https://your-subdomain.authkit.app
WORKOS_CLIENT_ID=client_...

# This API's public URL. `modal deploy` prints it; set it here and deploy again.
PUBLIC_URL=https://your-workspace--docs-search-web.modal.run
